flowchart TD
    Start((Mulai)) --> A[Buka halaman Login]
    A --> B[Isi email & password]
    B --> C{Kredensial valid?}
    C -- Tidak --> D[Tampilkan pesan error]
    D --> B
    C -- Ya --> E{role = admin?}
    E -- Ya --> F["Redirect ke /admin"]
    E -- Tidak --> G["Redirect ke Beranda"]
    F --> End((Selesai))
    G --> End
