classDiagram
    class User {
        +int id
        +string name
        +string email
        +string password
        +string role
        +string avatar
        +string google_id
        +isAdmin() bool
        +favorites() HasMany
        +reviews() HasMany
        +itineraries() HasMany
    }

    class Category {
        +int id
        +string name
        +string slug
        +string icon
        +destinations() HasMany
    }

    class Destination {
        +int id
        +int category_id
        +string name
        +string slug
        +text description
        +text recommendation_reason
        +string address
        +decimal latitude
        +decimal longitude
        +int price_min
        +int price_max
        +time open_time
        +time close_time
        +string cover_photo
        +bool is_active
        +category() BelongsTo
        +photos() HasMany
        +favorites() HasMany
        +reviews() HasMany
        +itineraryItems() HasMany
        +averageRating() float
        +isFavoritedBy(User) bool
        +isOpenNow() bool
    }

    class DestinationPhoto {
        +int id
        +int destination_id
        +string path
        +destination() BelongsTo
    }

    class Favorite {
        +int id
        +int user_id
        +int destination_id
        +user() BelongsTo
        +destination() BelongsTo
    }

    class Review {
        +int id
        +int user_id
        +int destination_id
        +int rating
        +text comment
        +bool is_visible
        +user() BelongsTo
        +destination() BelongsTo
    }

    class Itinerary {
        +int id
        +int user_id
        +string title
        +date start_date
        +date end_date
        +string type
        +user() BelongsTo
        +items() HasMany
        +totalDays() int
        +itemsByDay() Collection
    }

    class ItineraryItem {
        +int id
        +int itinerary_id
        +int destination_id
        +int day_number
        +time start_time
        +int duration_minutes
        +int sort_order
        +text notes
        +itinerary() BelongsTo
        +destination() BelongsTo
        +endTime() Carbon
    }

    class DistanceService {
        <<service>>
        +haversineKm(lat1, lng1, lat2, lng2) float$
        +estimateDurationMinutes(km) int$
    }

    class OperatingHoursService {
        <<service>>
        +isOpenAt(open, close, moment) bool$
        +isWithinWindow(open, close, start, end) bool$
    }

    class NearestNeighborSorter {
        <<service>>
        +sort(items, startLat, startLng) Collection$
    }

    class ScheduleValidator {
        <<service>>
        +validateDay(dayItems) array$
        +isWithinOperatingHours(item) bool$
    }

    User "1" -- "0..*" Favorite
    User "1" -- "0..*" Review
    User "1" -- "0..*" Itinerary
    Category "1" -- "0..*" Destination
    Destination "1" -- "0..*" DestinationPhoto
    Destination "1" -- "0..*" Favorite
    Destination "1" -- "0..*" Review
    Destination "1" -- "0..*" ItineraryItem
    Itinerary "1" -- "0..*" ItineraryItem
    NearestNeighborSorter ..> ItineraryItem : sorts
    NearestNeighborSorter ..> DistanceService : uses
    ScheduleValidator ..> ItineraryItem : validates
    ScheduleValidator ..> OperatingHoursService : uses
    Destination ..> OperatingHoursService : uses
