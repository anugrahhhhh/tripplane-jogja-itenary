sequenceDiagram
    actor U as User
    participant B as Browser
    participant C as AuthenticatedSessionController
    participant M as User (Model)
    participant DB as MySQL

    U->>B: Isi form login, submit
    B->>C: POST /login
    C->>M: authenticate()
    M->>DB: SELECT * FROM users WHERE email = ?
    DB-->>M: baris user
    M-->>C: kredensial valid
    C->>C: user->isAdmin()
    alt role = admin
        C-->>B: redirect /admin
    else role = traveler
        C-->>B: redirect /dashboard
    end
    B-->>U: Tampilkan halaman tujuan
