sequenceDiagram
    actor U as User
    participant JS as Alpine.js
    participant NC as NearbyController
    participant DS as DistanceService
    participant D as Destination (Model)
    participant DB as MySQL

    U->>JS: Aktifkan lokasi / klik peta
    JS->>JS: navigator.geolocation.getCurrentPosition()
    JS->>NC: GET /terdekat/cari?lat&lng&radius
    NC->>D: destinasi aktif
    D->>DB: SELECT * FROM destinations WHERE is_active
    DB-->>D: daftar destinasi
    loop tiap destinasi
        NC->>DS: haversineKm(lat, lng, d.lat, d.lng)
        DS-->>NC: jarak (km)
        NC->>D: isOpenNow()
        D-->>NC: true/false
    end
    NC->>NC: filter radius, sort by distance
    NC-->>JS: JSON { data: [...] }
    JS->>JS: render marker Leaflet + kartu
    JS-->>U: Tampilkan hasil terurut jarak
