flowchart TD
    Start((Mulai)) --> A[Buka Detail Destinasi]
    A --> B{Sudah login?}
    B -- Tidak --> C[Redirect ke Login]
    C --> End1((Selesai))
    B -- Ya --> D["Klik 'Tambahkan ke Itinerary'"]
    D --> E{Punya itinerary?}
    E -- Tidak --> F[Arahkan buat itinerary baru]
    F --> End2((Selesai))
    E -- Ya --> G[Pilih itinerary, hari & jam kunjungan]
    G --> H[Submit form]
    H --> I{Validasi lolos?}
    I -- Tidak --> J[Tampilkan pesan error]
    J --> G
    I -- Ya --> K[Simpan itinerary_item]
    K --> L[Tampilkan notifikasi sukses]
    L --> End3((Selesai))
