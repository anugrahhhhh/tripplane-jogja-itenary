flowchart TD
    Start((Mulai)) --> A[Buka Rekomendasi Terdekat]
    A --> B{Izinkan akses lokasi?}
    B -- Ya --> C[Ambil koordinat browser]
    B -- Tidak --> D[Pilih titik manual di peta]
    C --> E[Pilih radius 1/3/5 km]
    D --> E
    E --> F[Hitung jarak Haversine tiap destinasi]
    F --> G[Tampilkan daftar terurut jarak + status buka/tutup]
    G --> H{Sudah login?}
    H -- Tidak --> I[Hanya bisa lihat & buka detail]
    I --> End1((Selesai))
    H -- Ya --> J[Centang beberapa destinasi]
    J --> K["Klik 'Tambahkan ke Itinerary Hari Ini'"]
    K --> L[Buat/pakai itinerary bertipe today]
    L --> M[Urutkan destinasi terpilih berdasarkan jarak]
    M --> N[Simpan sebagai itinerary_item]
    N --> O[Redirect ke halaman itinerary]
    O --> End2((Selesai))
