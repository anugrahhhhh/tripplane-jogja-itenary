@startuml 09-sequence-ai-itinerary
title Sequence Diagram - Susun Itinerary dengan AI

skinparam sequence {
  ArrowColor #2F6B5A
  LifeLineBorderColor #2F6B5A
  ParticipantBorderColor #2F6B5A
  ParticipantBackgroundColor #FAF8F3
  ActorBackgroundColor #E8D5DA
}

actor Traveler
participant "AiItineraryController" as Ctrl
participant "RateLimiter" as RL
participant "AiItineraryPlannerService" as Planner
participant "Destination (Model)" as Dest
participant "Gemini API\n(generativelanguage.googleapis.com)" as Gemini
participant "Itinerary (Model)" as Itin
participant "ItineraryItem (Model)" as Item
database "MySQL" as DB

Traveler -> Ctrl : POST /itinerary/buat-ai\n(judul, tanggal, minat, budget, lokasi)
Ctrl -> RL : tooManyAttempts(ip, 3)
alt terlampaui
  RL --> Ctrl : true
  Ctrl --> Traveler : 302 kembali + error rate limit
else belum terlampaui
  RL --> Ctrl : false
  Ctrl -> RL : hit(ip, 120)
  Ctrl -> Ctrl : validasi input\n+ hitung totalDays
  alt totalDays > 7
    Ctrl --> Traveler : 302 kembali + error "maks 7 hari"
  else totalDays valid
    Ctrl -> Planner : plan(preferensi)
    Planner -> Dest : where(is_active)->with(category)->get()
    Dest -> DB : SELECT * FROM destinations JOIN categories
    DB --> Dest : daftar destinasi aktif
    Dest --> Planner : Collection<Destination>
    Planner -> Planner : buildDestinationCatalog()\n(ringkas + hitung jarak opsional)
    Planner -> Planner : buildPrompt()

    loop untuk setiap model (utama, lalu cadangan)
      Planner -> Gemini : POST models/{model}:generateContent\n(prompt + responseSchema, timeout 20s)
      alt 429 / 503 / timeout
        Planner -> Gemini : coba ulang 1x (jeda 1 detik)
      end
      alt 200 OK
        Gemini --> Planner : {"days":[{"day_number":1,"items":[...]}]}
        note right : keluar dari loop
      else 404 / 429 / 503 / timeout
        Gemini --> Planner : error
        Planner -> Planner : catat log, pindah ke model cadangan
      else error lain (mis. 400 / 401)
        Gemini --> Planner : error
        note right : berhenti, tidak mencoba model lain
      end
    end

    alt semua model gagal
      Planner --> Ctrl : throw RuntimeException\n"Server AI sedang sangat sibuk"
      Ctrl --> Traveler : 302 kembali + error AI (input tetap terisi)
    else berhasil
      Planner -> Planner : decode JSON, petakan\ndestination_id -> Destination asli
      Planner --> Ctrl : array days => items[destination, start_time,\nduration_minutes, note]

      alt hasil kosong
        Ctrl --> Traveler : 302 kembali + "AI tidak berhasil\nmenyusun itinerary"
      else ada jadwal
        group DB::transaction
          Ctrl -> Itin : create(user, title, start_date,\nend_date, type=planned)
          Itin -> DB : INSERT INTO itineraries
          loop untuk setiap hari & item
            Ctrl -> Item : create(itinerary_id, destination_id,\nday_number, start_time, duration_minutes,\nsort_order, notes)
            Item -> DB : INSERT INTO itinerary_items
          end
        end
        Ctrl --> Traveler : redirect ke Itinerary\n+ status sukses
      end
    end
  end
end

@enduml
