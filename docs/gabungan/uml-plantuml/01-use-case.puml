@startuml 01-use-case
title JogjaTrip - Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
}

actor Guest as guest
actor "Traveler" as traveler
actor "Admin" as admin
actor "Scheduler\n(Cron)" as scheduler <<system>>
actor "Google OAuth" as google <<external>>
actor "Gemini AI" as gemini <<external>>
actor "Open-Meteo" as meteo <<external>>

traveler --|> guest
admin --|> guest

rectangle "JogjaTrip" {

  package "Katalog & Pencarian" {
    usecase "Lihat Beranda" as UC_Home
    usecase "Cari & Filter Destinasi" as UC_Search
    usecase "Lihat Detail Destinasi" as UC_Detail
    usecase "Lihat Destinasi Terdekat\n(geolokasi)" as UC_Nearby
    usecase "Lihat Rekomendasi AI\n(personalisasi)" as UC_AiReco
  }

  package "Akun" {
    usecase "Daftar Akun" as UC_Register
    usecase "Masuk (Traveler)" as UC_Login
    usecase "Masuk dengan Google" as UC_LoginGoogle
    usecase "Masuk sebagai Admin" as UC_LoginAdmin
    usecase "Kelola Profil" as UC_Profile
    usecase "Keluar" as UC_Logout
  }

  package "Interaksi Sosial" {
    usecase "Kelola Favorit" as UC_Favorite
    usecase "Tulis Ulasan" as UC_Review
  }

  package "Itinerary" {
    usecase "Buat Itinerary Manual" as UC_ItineraryCreate
    usecase "Susun Itinerary dengan AI" as UC_ItineraryAi
    usecase "Buat Itinerary Hari Ini\n(dari destinasi terdekat)" as UC_TodayItinerary
    usecase "Kelola Item Itinerary\n(tambah/ubah/hapus)" as UC_ItineraryItem
    usecase "Urutkan Otomatis\n(nearest neighbor)" as UC_AutoSort
    usecase "Lihat Peringatan Jadwal\n(bentrok / di luar jam buka)" as UC_ScheduleWarning
    usecase "Lihat Prakiraan Cuaca\nItinerary" as UC_Weather
    usecase "Lihat Peta Rute" as UC_RouteMap
    usecase "Unduh PDF Itinerary" as UC_Pdf
    usecase "Undang Kolaborator" as UC_InviteCollab
    usecase "Keluarkan / Keluar\ndari Kolaborasi" as UC_RemoveCollab
  }

  package "Notifikasi" {
    usecase "Lihat Notifikasi" as UC_Notification
    usecase "Terima Pengingat H-1\nItinerary" as UC_ReminderReceive
  }

  package "Administrasi (Admin)" {
    usecase "Kelola Kategori" as UC_AdminCategory
    usecase "Kelola Destinasi\n(+ upload foto)" as UC_AdminDestination
    usecase "Moderasi Ulasan" as UC_AdminReview
    usecase "Lihat Data Pengguna" as UC_AdminUser
    usecase "Lihat Dashboard Analitik" as UC_AdminDashboard
  }

  package "Otomatis (Sistem)" {
    usecase "Kirim Pengingat Itinerary\n(H-1, terjadwal)" as UC_SendReminder
  }
}

guest --> UC_Home
guest --> UC_Search
guest --> UC_Detail
guest --> UC_Nearby
guest --> UC_AiReco
guest --> UC_Register
guest --> UC_Login
guest --> UC_LoginGoogle
guest --> UC_LoginAdmin

UC_Login ..> UC_LoginAdmin : <<exclude>>
UC_LoginGoogle ..> UC_LoginAdmin : <<exclude>>

traveler --> UC_Favorite
traveler --> UC_Review
traveler --> UC_ItineraryCreate
traveler --> UC_ItineraryAi
traveler --> UC_TodayItinerary
traveler --> UC_ItineraryItem
traveler --> UC_Pdf
traveler --> UC_InviteCollab
traveler --> UC_RemoveCollab
traveler --> UC_Notification
traveler --> UC_Profile
traveler --> UC_Logout

UC_ItineraryAi ..> UC_ItineraryCreate : <<extend>>
UC_ItineraryItem ..> UC_AutoSort : <<extend>>
UC_ItineraryItem ..> UC_ScheduleWarning : <<include>>
UC_ItineraryCreate ..> UC_Weather : <<include>>
UC_ItineraryAi ..> UC_Weather : <<include>>
UC_ItineraryCreate ..> UC_RouteMap : <<include>>
UC_ItineraryAi ..> UC_RouteMap : <<include>>
UC_InviteCollab ..> UC_Notification : <<extend>>

admin --> UC_AdminCategory
admin --> UC_AdminDestination
admin --> UC_AdminReview
admin --> UC_AdminUser
admin --> UC_AdminDashboard
admin --> UC_Profile
admin --> UC_Logout

UC_LoginGoogle ..> google : <<use>>
UC_AiReco ..> gemini : <<use>>
UC_ItineraryAi ..> gemini : <<use>>
UC_Weather ..> meteo : <<use>>
UC_RouteMap ..> "OpenStreetMap" : <<use>>

scheduler --> UC_SendReminder
UC_SendReminder ..> UC_ReminderReceive : <<include>>
traveler --> UC_ReminderReceive

@enduml
