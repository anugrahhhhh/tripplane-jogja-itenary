@startuml 14-class-diagram
title JogjaTrip - Class Diagram (Domain Model, Services, Auth/2FA, Notifications)

skinparam class {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  HeaderBackgroundColor #E8D5DA
}
hide circle
skinparam linetype ortho

package "Models" {
  class User {
    +id: int
    +name: string
    +email: string
    -password: string
    +role: enum(admin, traveler)
    +avatar: string
    +google_id: string
    +email_verified_at: datetime
    -remember_token: string
    -two_factor_secret: string <<encrypted>>
    -two_factor_recovery_codes: array <<encrypted>>
    -two_factor_confirmed_at: datetime
    -two_factor_last_used_step: int
    --
    +isAdmin(): bool
    +hasTwoFactorEnabled(): bool
    +recoveryCodesRemaining(): int
    +trustedDevices(): HasMany<TrustedDevice>
    +favorites(): HasMany<Favorite>
    +reviews(): HasMany<Review>
    +itineraries(): HasMany<Itinerary>
    +collaboratingItineraries(): BelongsToMany<Itinerary>
  }

  class TrustedDevice {
    +id: int
    +user_id: int
    -token_hash: string (SHA-256)
    +user_agent: string
    +ip_address: string
    +last_used_at: datetime
    +expires_at: datetime
    --
    +user(): BelongsTo<User>
  }

  class Category {
    +id: int
    +name: string
    +slug: string
    +icon: string
    --
    +destinations(): HasMany<Destination>
  }

  class Destination {
    +id: int
    +category_id: int
    +name: string
    +slug: string
    +description: text
    +recommendation_reason: text
    +address: string
    +latitude: float
    +longitude: float
    +price_min: int
    +price_max: int
    +open_time: time
    +close_time: time
    +closed_days: array<int> (1=Senin..7=Minggu)
    +cover_photo: string
    +is_active: bool
    --
    +category(): BelongsTo<Category>
    +photos(): HasMany<DestinationPhoto>
    +favorites(): HasMany<Favorite>
    +reviews(): HasMany<Review>
    +visibleReviews(): HasMany<Review>
    +itineraryItems(): HasMany<ItineraryItem>
    +averageRating(): float
    +reviewsCount(): int
    +isFavoritedBy(user): bool
    +isOpenNow(): bool
  }

  class DestinationPhoto {
    +id: int
    +destination_id: int
    +path: string
    --
    +destination(): BelongsTo<Destination>
  }

  class Favorite {
    +id: int
    +user_id: int
    +destination_id: int
    --
    +user(): BelongsTo<User>
    +destination(): BelongsTo<Destination>
  }

  class Review {
    +id: int
    +user_id: int
    +destination_id: int
    +rating: tinyint(1-5)
    +comment: text
    +is_visible: bool
    --
    +user(): BelongsTo<User>
    +destination(): BelongsTo<Destination>
  }

  class Itinerary {
    +id: int
    +user_id: int
    +title: string
    +start_date: date
    +end_date: date
    +traveler_count: int (1-50)
    +type: enum(planned, today)
    +share_token: string(40) nullable
    +reminder_sent_at: datetime
    --
    +user(): BelongsTo<User>
    +items(): HasMany<ItineraryItem>
    +collaborators(): BelongsToMany<User>
    +totalDays(): int
    +itemsByDay(): Collection
    +isActive(): bool
    +plannedProgress(): int
    +emoji(): string
    +isOwnedBy(user): bool
    +isAccessibleBy(user): bool
  }

  class ItineraryItem {
    +id: int
    +itinerary_id: int
    +destination_id: int
    +day_number: int
    +start_time: time
    +duration_minutes: int
    +sort_order: int
    +notes: string
    --
    +itinerary(): BelongsTo<Itinerary>
    +destination(): BelongsTo<Destination>
    +endTime(): Carbon
  }
}

package "Services" {
  class DistanceService <<static>> {
    +{static} haversineKm(lat1, lng1, lat2, lng2): float
    +{static} estimateDurationMinutes(distanceKm, avgSpeed=30): int
  }

  class OperatingHoursService <<static>> {
    +{static} isOpenAt(openTime, closeTime, moment): bool
    +{static} isWithinWindow(openTime, closeTime, startMin, endMin): bool
  }

  class ScheduleValidator <<static>> {
    +{static} validateDay(dayItems, date=null): array
    +{static} isWithinOperatingHours(item): bool
  }

  class NearestNeighborSorter <<static>> {
    +{static} sort(items, startLat=null, startLng=null): Collection
  }

  class ItineraryInsights <<static>> {
    +{static} build(itinerary): array (mapPoints, warnings, travelInfo)
    #{static} travelInfoBetween(items): array
  }

  class ItineraryCostEstimator {
    +estimate(itinerary): array (days, total, travelers, group_total)
  }

  class WeatherService {
    +forecastForDateRange(lat, lng, startDate, endDate): array
  }

  class LlmRecommendationService {
    +recommend(preferences): array
  }

  class AiItineraryPlannerService {
    +plan(preferences): array
  }

  interface CallsGeminiApi <<trait>> {
    #requestGeminiJson(prompt, responseSchema): array
    -geminiModelChain(): array
    -callGeminiModel(apiKey, model, prompt, schema): Response
  }

  interface BuildsDestinationCatalog <<trait>> {
    #buildDestinationCatalog(destinations, lat, lng): Collection
  }
}

package "Auth (2FA)" {
  class TwoFactorGate {
    +PENDING_TTL_MINUTES = 5
    --
    +pass(request, user, method, intended): RedirectResponse
  }

  class TwoFactorAuthenticator {
    -RECOVERY_CODE_COUNT = 8
    --
    +generateSecret(): string
    +qrCodeSvg(user, secret): string
    +verifySecretCode(secret, code, lastUsedStep): ?int
    +verifyUserCode(user, code): bool
    +generateRecoveryCodes(): array (plain, hashed)
    +useRecoveryCode(user, code): bool
    +disable(user): void
  }

  class TrustedDeviceManager {
    +COOKIE = "trusted_device"
    +DAYS = 30
    --
    +trust(user, request): TrustedDevice
    +isTrusted(user, request): bool
    +revoke(device): void
    +revokeAll(user): int
  }

  class SecureAccountAction {
    +handle(user): void
  }
}

package "Notifications (ShouldQueue: mail + database)" {
  class ItineraryReminderNotification {
    #itinerary: Itinerary
  }
  class NewLoginNotification {
    #ipAddress: string
    #device: string
    #methodLabel: string
    #at: CarbonInterface
    --
    -notMeUrl(notifiable): string
  }
  class RecoveryCodeUsedNotification {
    #remaining: int
  }
  class TwoFactorEnabledNotification
  class TwoFactorResetByAdminNotification
}

' ===== Relasi antar model =====
Category "1" -- "many" Destination : memiliki >
Destination "1" -- "many" DestinationPhoto : galeri >
Destination "1" -- "many" ItineraryItem : dijadwalkan di >

User "1" -- "many" Favorite
Favorite "many" -- "1" Destination
User "1" -- "many" Review
Review "many" -- "1" Destination
User "1" *-- "many" TrustedDevice : perangkat tepercaya >

User "1" -- "many" Itinerary : memiliki (owner) >
Itinerary "many" -- "many" User : kolaborator\n(itinerary_collaborators) >
Itinerary "1" *-- "many" ItineraryItem : terdiri dari

' ===== Service menggunakan model =====
ItineraryItem <.. ScheduleValidator : memvalidasi
ItineraryItem <.. NearestNeighborSorter : mengurutkan
Destination <.. DistanceService : hitung jarak
Destination <.. LlmRecommendationService : katalog rekomendasi
Destination <.. AiItineraryPlannerService : katalog itinerary
Itinerary <.. ItineraryInsights : peta, peringatan,\njarak per hari
Itinerary <.. ItineraryCostEstimator : estimasi biaya tiket
Itinerary <.. ItineraryReminderNotification : dikirim untuk

LlmRecommendationService ..|> CallsGeminiApi : use
LlmRecommendationService ..|> BuildsDestinationCatalog : use
AiItineraryPlannerService ..|> CallsGeminiApi : use
AiItineraryPlannerService ..|> BuildsDestinationCatalog : use
NearestNeighborSorter ..> DistanceService : memakai
ItineraryInsights ..> ScheduleValidator : memakai
ItineraryInsights ..> DistanceService : memakai
ScheduleValidator ..> OperatingHoursService : memakai
Destination ..> OperatingHoursService : isOpenNow()

' ===== Auth / 2FA =====
TwoFactorGate ..> TrustedDeviceManager : memakai
TwoFactorGate ..> User : memeriksa 2FA
TrustedDeviceManager ..> TrustedDevice : kelola
SecureAccountAction ..> TrustedDeviceManager : revokeAll()
SecureAccountAction ..> TwoFactorAuthenticator : disable()
TwoFactorAuthenticator ..> User : baca/tulis kolom 2FA

User <.. NewLoginNotification : dikirim ke
User <.. RecoveryCodeUsedNotification : dikirim ke
User <.. TwoFactorEnabledNotification : dikirim ke
User <.. TwoFactorResetByAdminNotification : dikirim ke

@enduml
