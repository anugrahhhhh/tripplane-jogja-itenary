@startuml 03-activity-ai-itinerary
title Activity Diagram - Susun Itinerary dengan AI

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

|Traveler|
start
:Buka /itinerary/buat-ai;
:Isi preferensi\n(judul, tanggal mulai/selesai,\nminat, catatan, budget/hari, lokasi opsional);
:Submit form;

|AiItineraryController|
if (Rate limit terlampaui?\n(maks 3x / 2 menit)) then (ya)
  :Set pesan error\n"Terlalu banyak percobaan";
  |Traveler|
  :Lihat pesan error, form terisi ulang;
  stop
else (tidak)
endif

:Validasi input\n(tanggal, minat, budget, lokasi);
:Hitung total hari\n(end_date - start_date + 1);

if (Total hari > 7?) then (ya)
  :Set pesan error\n"Maksimal 7 hari";
  |Traveler|
  :Lihat pesan error;
  stop
else (tidak)
endif

|AiItineraryPlannerService|
:Ambil semua destinasi aktif\n+ eager load kategori;
:Bangun katalog destinasi ringkas\n(BuildsDestinationCatalog);
:Susun prompt\n(preferensi + katalog + aturan penjadwalan);

partition "Gemini API (CallsGeminiApi)" {
  :Kirim request generateContent ke model utama\n(responseSchema JSON hari & item, timeout 20s,\ncoba ulang 1x jika 429/503/timeout);
  while (Gagal 404/429/503/timeout\ndan masih ada model cadangan?) is (ya)
    :Log peringatan,\npindah ke model cadangan berikutnya;
  endwhile (tidak)
}

if (Semua model gagal\natau error lain (400/401)?) then (ya)
  |AiItineraryController|
  :Tangkap RuntimeException;
  :Set pesan error\n"Server AI sedang sangat sibuk";
  |Traveler|
  :Lihat pesan error;
  stop
else (tidak)
endif

:Decode JSON respons;
:Petakan tiap destination_id\nke model Destination asli\n(abaikan id yang tidak valid);
:Validasi start_time (format HH:MM)\ndan duration_minutes (15-600);

if (Hasil hari kosong\nsetelah pemetaan?) then (ya)
  |AiItineraryController|
  :Set pesan error\n"AI tidak berhasil menyusun itinerary";
  |Traveler|
  :Lihat pesan error;
  stop
else (tidak)
endif

|AiItineraryController|
partition "Transaksi Database" {
  :Buat Itinerary\n(owner=traveler, type=planned);
  while (untuk setiap hari & item hasil AI?) is (masih ada)
    :Buat ItineraryItem\n(destination, day_number, start_time,\nduration_minutes, sort_order, notes=alasan AI);
  endwhile (selesai)
}

:Redirect ke halaman Itinerary\ndengan status sukses;

|Traveler|
:Lihat itinerary tersusun otomatis\n(bisa diedit manual selanjutnya);
stop

@enduml
