@startuml 02-activity-login
title Activity Diagram - Masuk (Traveler, Google, Admin) + 2FA Wajib

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

start
:Buka halaman /login\natau /admin/login;

partition "Kredensial utama" {
  if (Metode masuk?) then (Email & Password)
    :Isi email & password;
    :LoginRequest::validatedUser();
    if (Rate limit terlampaui?\n(maks 5x per email+IP)) then (ya)
      :Error "Terlalu banyak percobaan,\ncoba lagi dalam N detik";
      stop
    else (tidak)
    endif
    if (Kredensial valid?) then (tidak)
      :RateLimiter::hit();
      :Error "email/password salah";
      stop
    else (ya)
      :RateLimiter::clear();
    endif
    if (Pintu masuk cocok dengan role?\n(/login = traveler, /admin/login = admin)) then (tidak)
      :Error "Akun Admin masuk lewat halaman Admin"\natau "Akun ini bukan akun Admin";
      note right : belum ada sesi login,\njadi tidak perlu logout
      stop
    else (ya)
    endif

  else (Google, hanya /login)
    :Klik "Lanjutkan dengan Google";
    :GoogleAuthController::redirect();
    :Pengguna setujui akses di layar consent Google;
    :GoogleAuthController::callback();
    if (Profil Google berhasil diambil?) then (tidak)
      :Error "Gagal masuk dengan Google";
      stop
    else (ya)
    endif
    if (User ditemukan\nvia google_id atau email?) then (ya)
      if (user.role == admin?) then (ya)
        :Error "Akun ini adalah akun Admin";
        stop
      else (tidak)
        :Tautkan google_id jika belum;
      endif
    else (tidak)
      :Buat akun baru\n(role=traveler, email_verified_at=now);
    endif
  endif
}

partition "TwoFactorGate::pass()" {
  if (2FA sudah aktif?) then (belum)
    :Auth::login(user);
    :Redirect ke /dua-faktor/aktifkan;
    partition "Aktifkan 2FA (wajib)" {
      :Buat secret, tampilkan QR code;
      repeat
        :Pengguna pindai QR\n& isi kode 6 digit;
      repeat while (Kode valid?) is (tidak)
      -> ya;
      :Buat 8 recovery code;
      :Simpan secret + recovery code (terenkripsi),\nset two_factor_confirmed_at;
      :Kirim TwoFactorEnabledNotification;
      :Tampilkan recovery code (sekali);
      :Pengguna konfirmasi sudah menyimpan;
    }
  elseif (Perangkat tepercaya?\n(cookie trusted_device valid)) then (ya)
    :Auth::login(user);
  else (tidak)
    :Simpan two_factor.pending di sesi\n(berlaku 5 menit);
    :Redirect ke /dua-faktor;
    partition "Verifikasi kode" {
      repeat
        :Isi kode authenticator\natau recovery code;
        if (Pending kedaluwarsa?) then (ya)
          :Error "Waktu habis, silakan masuk lagi";
          stop
        else (tidak)
        endif
      repeat while (Kode salah / rate limit\n(maks 5x per menit)?) is (ya)
      -> kode benar;
      :Auth::login(user), regenerasi session;
      if (Centang "Percayai perangkat ini"?) then (ya)
        :Simpan TrustedDevice (30 hari)\n+ set cookie;
      else (tidak)
      endif
      :Kirim NewLoginNotification\n(tombol "Bukan saya");
      if (Memakai recovery code?) then (ya)
        :Hapus kode terpakai;
        :Kirim RecoveryCodeUsedNotification;
      else (tidak)
      endif
    }
  endif
}

:Redirect ke tujuan\n(Beranda / Dashboard Admin);
stop

@enduml
