@startuml 06-activity-reminder
title Activity Diagram - Pengingat Itinerary Terjadwal (H-1)

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

|Scheduler (Cron)|
start
:Trigger harian 08:00\n(php artisan schedule:run);
:Jalankan\napp:send-itinerary-reminders;

|SendItineraryReminders|
:Hitung tanggal besok\n(today()->addDay());
:Query Itinerary dengan\nstart_date = besok\nDAN reminder_sent_at IS NULL;

if (Ada itinerary ditemukan?) then (tidak)
  :Log "Tidak ada itinerary\nyang mulai besok";
  stop
else (ya)
endif

while (untuk setiap itinerary?) is (masih ada)
  :Kumpulkan penerima\n(pemilik + seluruh kolaborator, unik);
  while (untuk setiap penerima?) is (masih ada)
    :notify(ItineraryReminderNotification)\n-> masuk antrean (tabel jobs);
  endwhile (selesai)
  :Set reminder_sent_at = now()\npada itinerary ini\n(cegah kirim dobel);
endwhile (selesai)

:Selesai, log ringkasan\njumlah itinerary diproses;

|Queue Worker|
while (Ada job di antrean?) is (ya)
  partition "Kanal: mail" {
    :Susun MailMessage\n(judul, tanggal, link itinerary);
    :Kirim email\n(tercatat di log driver\njika SMTP belum diisi);
  }
  partition "Kanal: database" {
    :Simpan baris notifications\n(itinerary_id, title, message);
  }
endwhile (tidak)
stop

@enduml
