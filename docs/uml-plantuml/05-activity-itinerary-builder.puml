@startuml 05-activity-itinerary-builder
title Activity Diagram - Itinerary Builder Manual (Tambah Destinasi & Urutkan Otomatis)

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

start
:Buka halaman Itinerary,\npilih tab Day-N aktif;

if (Aksi apa?) then (Tambah Destinasi)
  :Klik "Tambah dari Kategori";
  :Pilih destinasi\n(favorit atau katalog lengkap);
  :Isi jam mulai, durasi, catatan;
  :Submit form;
  :ItineraryItemController::store();
  if (Requester pemilik\natau kolaborator?) then (tidak)
    :403 Forbidden;
    stop
  else (ya)
  endif
  :Validasi\n(destination_id, day_number 1..totalDays,\nstart_time format H:i, duration 15-600);
  :Hitung sort_order berikutnya\nuntuk hari tsb;
  :Simpan ItineraryItem baru;
  :Redirect kembali ke halaman Itinerary;

else (Urutkan Otomatis)
  :Klik "Urutkan Otomatis"\npada Day-N;
  :ItineraryItemController::autoSort();
  if (Requester pemilik\natau kolaborator?) then (tidak)
    :403 Forbidden;
    stop
  else (ya)
  endif
  :Ambil semua item hari itu\n+ eager load destinasi;
  if (Jumlah item < 2?) then (ya)
    :Status "Minimal butuh 2 destinasi\nuntuk diurutkan otomatis";
    stop
  else (tidak)
    :NearestNeighborSorter::sort()\n(greedy nearest-neighbor,\nHaversine antar koordinat);
    while (untuk setiap item hasil urutan?) is (masih ada)
      :Update sort_order sesuai\nurutan baru;
    endwhile (selesai)
    :Redirect kembali dengan status\n"Urutan berhasil disusun otomatis";
  endif
endif

:Muat ulang halaman Itinerary;
:ScheduleValidator::validateDay()\nuntuk hari aktif;

if (Ada item di luar jam operasional\natau jadwal bertabrakan?) then (ya)
  :Tampilkan badge peringatan\npada item terkait;
else (tidak)
endif

:Tampilkan peta rute (Leaflet)\n+ badge cuaca hari itu;
stop

@enduml
