@startuml 04-activity-kolaborasi
title Activity Diagram - Kolaborasi Itinerary (Undang / Keluarkan / Keluar)

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

start
:Buka halaman Itinerary;

if (Aksi apa?) then (Undang Kolaborator)
  :Pemilik isi email traveler\ndi form "Undang";
  :ItineraryCollaboratorController::store();
  if (Requester adalah pemilik\nitinerary ini?) then (tidak)
    :403 Forbidden;
    stop
  else (ya)
  endif
  :Cari user berdasarkan email;
  if (User ditemukan?) then (tidak)
    :Error "Belum ada akun\nterdaftar dengan email ini";
    stop
  else (ya)
  endif
  if (Email = email pemilik sendiri?) then (ya)
    :Error "Ini email kamu sendiri";
    stop
  else (tidak)
  endif
  if (User adalah Admin?) then (ya)
    :Error "Akun Admin tidak bisa\ndiundang sebagai kolaborator";
    stop
  else (tidak)
  endif
  if (Sudah jadi kolaborator?) then (ya)
    :Error "Sudah jadi kolaborator\ndi itinerary ini";
    stop
  else (tidak)
    :Tambahkan ke\nitinerary_collaborators (attach);
    :Redirect kembali dengan status\n"<Nama> berhasil diundang";
    stop
  endif

else (Keluarkan / Keluar)
  :Klik "Keluarkan" (pemilik)\natau "Keluar" (kolaborator sendiri);
  :ItineraryCollaboratorController::destroy();
  if (Requester = pemilik\nATAU requester = kolaborator\nyang mau dihapus?) then (tidak)
    :403 Forbidden;
    stop
  else (ya)
  endif
  :Detach dari\nitinerary_collaborators;
  if (Yang keluar adalah\ndiri sendiri (bukan pemilik)?) then (ya)
    :Redirect ke daftar Itinerary\ndengan status "Kamu keluar\ndari itinerary ini";
    stop
  else (tidak, pemilik mengeluarkan orang lain)
    :Redirect kembali dengan status\n"<Nama> dikeluarkan";
    stop
  endif
endif

@enduml
