@startuml 02-activity-login
title Activity Diagram - Masuk (Traveler, Google, dan Admin terpisah)

skinparam activity {
  BackgroundColor #FAF8F3
  BorderColor #2F6B5A
  ArrowColor #2F6B5A
  DiamondBackgroundColor #E8D5DA
}

start
:Buka halaman /login\natau /admin/login;

if (Pintu masuk mana?) then (/admin/login)
  :Isi email & password Admin;
  :AuthenticatedSessionController(Admin)::store();
  if (Kredensial valid?) then (tidak)
    :Tampilkan error "email/password salah";
    stop
  else (ya)
  endif
  if (user.role == admin?) then (tidak)
    :Logout paksa sesi;
    :Tampilkan error\n"Akun ini bukan akun Admin";
    stop
  else (ya)
    :Regenerasi session;
    :Redirect ke /admin (Dashboard);
    stop
  endif

else (/login)
  if (Metode masuk?) then (Email & Password)
    :Isi email & password;
    :AuthenticatedSessionController::store();
    if (Kredensial valid?) then (tidak)
      :Tampilkan error "email/password salah";
      stop
    else (ya)
    endif
    if (user.role == admin?) then (ya)
      :Logout paksa sesi;
      :Tampilkan error\n"Akun ini adalah akun Admin,\nmasuk lewat halaman Admin";
      stop
    else (tidak)
      :Regenerasi session;
      :Redirect ke Beranda;
      stop
    endif

  else (Google)
    :Klik "Lanjutkan dengan Google";
    :GoogleAuthController::redirect();
    partition "Google OAuth" {
      :Tampilkan layar consent Google;
      :Pengguna login & setujui akses;
      :Redirect kembali ke\n/auth/google/callback?code=...;
    }
    :GoogleAuthController::callback();
    :Ambil profil (id, nama, email, avatar)\nlewat Socialite;
    if (User ditemukan\nvia google_id atau email?) then (ya)
      if (user.role == admin?) then (ya)
        :Tampilkan error\n"Akun ini adalah akun Admin";
        :Redirect ke /login;
        stop
      else (tidak)
        if (google_id belum tertaut?) then (ya)
          :Tautkan google_id ke akun;
        else (tidak)
        endif
      endif
    else (tidak)
      :Buat akun baru\n(role=traveler, email_verified_at=now);
    endif
    :Auth::login(user);
    :Redirect ke Beranda;
    stop
  endif
endif

@enduml
